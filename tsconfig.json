{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "skipLibCheck": true,
    "declaration": true, "sourceMap": false, "rootDir": "src", "outDir": "dist",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
